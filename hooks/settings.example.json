{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "bash \"<HOME>/.claude/hooks/bash-guard-lite.sh\"", "timeout": 5 }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "python", "args": ["-I", "-S", "<HOME>/.claude/hooks/wait_mode.py", "pre"], "timeout": 5 }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"<HOME>\\Claude\\night-watch.ps1\"" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "python", "args": ["-I", "-S", "<HOME>/.claude/hooks/wait_mode.py", "prompt"], "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "python", "args": ["-I", "-S", "<HOME>/.claude/hooks/ci_wait_hook.py", "post"], "timeout": 30 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "python", "args": ["-I", "-S", "<HOME>/.claude/hooks/ci_wait_hook.py", "stop"], "timeout": 90 }
        ]
      }
    ]
  }
}
